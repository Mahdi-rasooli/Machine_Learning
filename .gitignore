# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Environments ----
.venv/
venv/
env/
ENV/
.python-version

# ---- Testing / coverage ----
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ---- Jupyter ----
.ipynb_checkpoints/
# NOTE: notebook *outputs* are intentionally committed so plots and results
# render on GitHub without anyone needing to run the code.
# See docs/repo-structure.md for the reasoning.

# ---- IDE / editors ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Data ----
# Datasets ARE committed under each lesson's or project's data/ folder.
# Nothing over GitHub's 100 MB limit: large CSVs are committed gzip-compressed
# (.csv.gz), and a large dataset is stored once and shared, not copied.
*.zip
*.tar.gz
*.7z
*.parquet
*.h5
*.hdf5
*.sqlite
*.db

# ---- Model artifacts ----
*.pkl
*.joblib
*.pt
*.pth
*.onnx
checkpoints/

# Course handouts and other material I did not write myself. Kept locally for
# reference, never published: anything from them that belongs in this repo gets
# rewritten in my own words first.
notes/
*.docx
